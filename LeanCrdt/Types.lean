/-!
# Basic types of the file-sync CRDT

Executable module: imports only `Init` (the Lean prelude), nothing from `Std`.

All orders used for observable data are platform-independent:
* `String` is compared by its UTF-8 bytes (`lean_string_compare`), which coincides with the
  lexicographic order on Unicode code points;
* `ByteArray` (hashes) is compared lexicographically (`lean_byte_array_compare`);
* `ReplicaId` by `(hi, lo)` as unsigned 64-bit integers, `Nat` numerically.

No `USize`, pointer or hash-of-object value is ever used in an order or stored in the state.
-/

namespace LeanCrdt

open Std

/-- Opaque 128-bit replica identifier, generated by the host (Lean never generates randomness).
The host maps its 16 bytes big-endian to `(hi, lo)`. -/
structure ReplicaId where
  hi : UInt64
  lo : UInt64
  deriving DecidableEq, Repr, Inhabited

instance : Ord ReplicaId := ⟨compareLex (compareOn ReplicaId.hi) (compareOn ReplicaId.lo)⟩

/-- A content hash: an opaque byte string supplied by the host. File contents never enter the CRDT. -/
structure Hash where
  bytes : ByteArray
  deriving DecidableEq, Inhabited

instance : Ord Hash := ⟨compareOn Hash.bytes⟩

/-- A dot `(replica, counter)` names one local edit event uniquely, provided each replica issues
counters 1, 2, 3, … from a single, never-rolled-back state (see the design note). -/
structure Dot where
  replica : ReplicaId
  counter : Nat
  deriving DecidableEq, Repr, Inhabited

instance : Ord Dot := ⟨compareLex (compareOn Dot.replica) (compareOn Dot.counter)⟩

/-- One live version of one file: the path, the event that wrote it, and the content hash. -/
structure Entry where
  path : String
  dot : Dot
  hash : Hash
  deriving DecidableEq, Inhabited

/-- Entries are ordered by `(path, dot, hash)`; the state keeps them strictly sorted. -/
instance : Ord Entry :=
  ⟨compareLex (compareOn Entry.path) (compareLex (compareOn Entry.dot) (compareOn Entry.hash))⟩

instance : TransOrd ReplicaId := inferInstanceAs (TransCmp (compareLex _ _))
instance : TransOrd Hash := inferInstanceAs (TransCmp (compareOn _))
instance : TransOrd Dot := inferInstanceAs (TransCmp (compareLex _ _))
instance : TransOrd Entry := inferInstanceAs (TransCmp (compareLex _ _))

theorem ReplicaId.compare_def (a b : ReplicaId) :
    compare a b = (compare a.hi b.hi).then (compare a.lo b.lo) := rfl
theorem Hash.compare_def (a b : Hash) : compare a b = compare a.bytes b.bytes := rfl
theorem Dot.compare_def (a b : Dot) :
    compare a b = (compare a.replica b.replica).then (compare a.counter b.counter) := rfl
theorem Entry.compare_def (a b : Entry) :
    compare a b = (compare a.path b.path).then
      ((compare a.dot b.dot).then (compare a.hash b.hash)) := rfl

instance : LawfulEqOrd ReplicaId where
  eq_of_compare {a b} h := by
    rw [ReplicaId.compare_def, Ordering.then_eq_eq] at h
    cases a; cases b
    simp only [ReplicaId.mk.injEq]
    exact ⟨LawfulEqOrd.eq_of_compare h.1, LawfulEqOrd.eq_of_compare h.2⟩

instance : LawfulEqOrd Hash where
  eq_of_compare {a b} h := by
    rw [Hash.compare_def] at h
    cases a; cases b
    simp only [Hash.mk.injEq]
    exact LawfulEqOrd.eq_of_compare h

instance : LawfulEqOrd Dot where
  eq_of_compare {a b} h := by
    rw [Dot.compare_def, Ordering.then_eq_eq] at h
    cases a; cases b
    simp only [Dot.mk.injEq]
    exact ⟨LawfulEqOrd.eq_of_compare h.1, LawfulEqOrd.eq_of_compare h.2⟩

instance : LawfulEqOrd Entry where
  eq_of_compare {a b} h := by
    rw [Entry.compare_def, Ordering.then_eq_eq, Ordering.then_eq_eq] at h
    cases a; cases b
    simp only [Entry.mk.injEq]
    exact ⟨LawfulEqOrd.eq_of_compare h.1, LawfulEqOrd.eq_of_compare h.2.1,
      LawfulEqOrd.eq_of_compare h.2.2⟩

/-- "Strictly sorted" for any `Ord`: each element is `compare`-less than every later one.
This is the canonical-form invariant of every list stored in the state. -/
def StrictlySorted {α} [Ord α] (l : List α) : Prop :=
  l.Pairwise (fun a b => compare a b = .lt)

end LeanCrdt
